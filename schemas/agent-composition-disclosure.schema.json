{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/agent-director-protocol/schemas/agent-composition-disclosure.schema.json",
  "title": "Agent Composition Disclosure",
  "description": "What the director visibly tells the user before dispatching any native subagent batch. One disclosure per batch, not per individual spawn. It includes a checkable work contract, director selection, worker model ceilings, justifications, conflict domains, execution mode, observed native capacity, and approval state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "director_model",
    "director_effort",
    "director_model_source",
    "phase",
    "user_visible",
    "work_contract",
    "subagent_count",
    "subagents",
    "execution_mode",
    "rescue_agent_available",
    "within_preapproved_range",
    "approval_status",
    "spawn_budget"
  ],
  "properties": {
    "director_model": {
      "type": "string",
      "minLength": 1,
      "description": "The model selected by the user for the current director session."
    },
    "director_effort": {
      "type": "string",
      "enum": ["low", "medium", "high", "xhigh", "max"]
    },
    "director_model_source": {
      "type": "string",
      "enum": ["user_selected_session", "explicit_user_cli_selection"],
      "description": "The protocol never selects the director model."
    },
    "phase": {
      "type": "string",
      "enum": ["task_start", "spawn", "addition"],
      "description": "Disclosure phase: every task starts with task_start; a worker batch uses spawn; a later worker, contract, or scope change uses addition."
    },
    "user_visible": {
      "type": "boolean",
      "const": true,
      "description": "The complete work contract and composition are visibly shown to the user before any spawn or state-changing work."
    },
    "work_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "scope",
        "planned_contracts",
        "planned_workers",
        "worker_model",
        "worker_reasoning_effort",
        "minimum_safe_rationale",
        "tests",
        "stop_conditions"
      ],
      "properties": {
        "objective": { "type": "string", "minLength": 1 },
        "scope": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          ]
        },
        "planned_contracts": { "type": "integer", "minimum": 1 },
        "planned_workers": { "type": "integer", "minimum": 0 },
        "worker_model": { "type": "string", "minLength": 1 },
        "worker_reasoning_effort": {
          "type": "string",
          "enum": ["low", "medium", "high", "xhigh", "max"]
        },
        "minimum_safe_rationale": {
          "type": "string",
          "minLength": 10,
          "description": "Why this composition is the minimum safe structure, using only conflict boundaries, dependencies, independent evidence/review, or blast-radius isolation, and why fewer existing contracts/workers cannot absorb it."
        },
        "tests": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          ]
        },
        "stop_conditions": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          ]
        },
        "read_only": {
          "type": "boolean",
          "description": "Required when task_start has no planned worker; it marks a read-only task that will not spawn."
        }
      },
      "description": "The user-visible contract summary required before the batch starts."
    },
    "subagent_count": {
      "type": "integer",
      "minimum": 0
    },
    "subagents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "task",
          "model",
          "model_ceiling",
          "effort",
          "justification",
          "model_source",
          "conflict_domains"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["investigator", "implementer", "reviewer", "rescue"],
            "description": "The bounded native custom-agent assignment."
          },
          "task": {
            "type": "string",
            "minLength": 1,
            "description": "Task ID or short description this subagent owns."
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "model_ceiling": {
            "type": "string",
            "minLength": 1,
            "description": "The active worker model ceiling selected by the adapter policy or explicit user policy."
          },
          "effort": {
            "type": "string",
            "enum": ["low", "medium", "high", "xhigh", "max"]
          },
          "justification": {
            "type": "string",
            "minLength": 10,
            "description": "Why this work needs its own subagent rather than being folded into another contract."
          },
          "model_source": {
            "type": "string",
            "enum": ["native_custom_agent", "native_subagent", "explicit_spawn_override", "explicit_user_policy"],
            "description": "How the worker model was selected."
          },
          "conflict_domains": {
            "$ref": "#/definitions/conflict_domains",
            "description": "All resources the worker may read or write."
          }
        }
      },
      "description": "One entry per subagent about to be spawned."
    },
    "execution_mode": {
      "type": "string",
      "enum": ["parallel", "sequential"],
      "description": "The planned batch execution mode after the conflict check."
    },
    "rescue_agent_available": {
      "type": "boolean",
      "description": "True only when the same worker model has a supported higher effort step."
    },
    "within_preapproved_range": {
      "type": "boolean",
      "description": "Whether the visible contract and observed native runtime permit this batch."
    },
    "approval_status": {
      "type": "string",
      "enum": ["not_required", "pending", "granted", "denied"],
      "description": "Approval state for any user-authorized exception or material scope change."
    },
    "spawn_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "already_spawned_count",
        "this_batch_count",
        "total_after_spawn",
        "capacity_source",
        "capacity_known"
      ],
      "properties": {
        "already_spawned_count": { "type": "integer", "minimum": 0 },
        "this_batch_count": { "type": "integer", "minimum": 0 },
        "total_after_spawn": { "type": "integer", "minimum": 0 },
        "capacity_source": { "type": "string", "minLength": 1 },
        "capacity_known": { "type": "boolean" },
        "observed_capacity": { "type": ["integer", "null"], "minimum": 0 }
      },
      "description": "Request accounting plus observed native capacity; no protocol numeric limit."
    },
    "addition": {
      "$ref": "#/definitions/addition_change",
      "description": "Required for phase=addition."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "phase": { "const": "spawn" } }
      },
      "then": {
        "properties": {
          "work_contract": { "properties": { "planned_workers": { "minimum": 1 } } },
          "subagent_count": { "minimum": 1 },
          "spawn_budget": { "properties": { "this_batch_count": { "minimum": 1 } } }
        }
      }
    },
    {
      "if": {
        "properties": { "phase": { "const": "addition" } }
      },
      "then": {
        "required": ["addition"],
        "properties": {
          "work_contract": { "properties": { "planned_workers": { "minimum": 1 } } },
          "subagent_count": { "minimum": 1 },
          "spawn_budget": { "properties": { "this_batch_count": { "minimum": 1 } } }
        }
      }
    },
    {
      "if": {
        "properties": {
          "work_contract": {
            "required": ["planned_workers"],
            "properties": { "planned_workers": { "const": 0 } }
          }
        }
      },
      "then": {
        "properties": {
          "work_contract": {
            "required": ["read_only"],
            "properties": { "read_only": { "const": true } }
          },
          "subagent_count": { "maximum": 0 },
          "spawn_budget": { "properties": { "this_batch_count": { "maximum": 0 } } }
        }
      }
    },
    {
      "if": { "properties": { "within_preapproved_range": { "const": true } } },
      "then": { "properties": { "approval_status": { "const": "not_required" } } }
    },
    {
      "if": { "properties": { "within_preapproved_range": { "const": false } } },
      "then": { "properties": { "approval_status": { "enum": ["pending", "granted"] } } }
    },
    {
      "if": { "properties": { "subagent_count": { "const": 0 } } },
      "then": { "properties": { "subagents": { "maxItems": 0 } } }
    }
  ],
  "definitions": {
    "addition_change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed_scope",
        "change_summary",
        "added_worker_task",
        "addition_basis",
        "why_existing_workers_cannot_absorb",
        "new_disclosure"
      ],
      "properties": {
        "changed_scope": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          ]
        },
        "change_summary": { "type": "string", "minLength": 1 },
        "added_worker_task": { "type": "string", "minLength": 1 },
        "addition_basis": {
          "type": "string",
          "enum": [
            "newly_discovered_evidence",
            "new_conflict_domain",
            "new_dependency",
            "mandatory_independent_review",
            "classified_failure"
          ]
        },
        "why_existing_workers_cannot_absorb": { "type": "string", "minLength": 10 },
        "new_disclosure": { "const": true }
      }
    },
    "conflict_domains": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": { "type": "array", "items": { "type": "string" } },
        "code_regions": { "type": "array", "items": { "type": "string" } },
        "data_structures": { "type": "array", "items": { "type": "string" } },
        "interfaces": { "type": "array", "items": { "type": "string" } },
        "schemas": { "type": "array", "items": { "type": "string" } },
        "db_entities": { "type": "array", "items": { "type": "string" } },
        "shared_configs": { "type": "array", "items": { "type": "string" } },
        "state_stores": { "type": "array", "items": { "type": "string" } },
        "generated_artifacts": { "type": "array", "items": { "type": "string" } },
        "build_targets": { "type": "array", "items": { "type": "string" } },
        "user_flows": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
